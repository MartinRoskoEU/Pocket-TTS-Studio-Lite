<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PocketTTSStudioLite</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\PocketTTSStudioLite\VoiceExportNotification.cs" Link="VoiceExportNotification.cs" />
    <Compile Include="..\..\PocketTTSStudioLite\AudioWaveformDisplay.cs" Link="AudioWaveformDisplay.cs" />
    <Compile Include="..\..\PocketTTSStudioLite\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\PocketTTSStudioLite\RuntimeMetadata\**\*.yaml;..\..\PocketTTSStudioLite\RuntimeMetadata\**\*.json" Link="RuntimeMetadata\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
