<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PocketTTSStudioLite</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\PocketTTSStudioLite\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\PocketTTSStudioLite\RuntimeMetadata\**\*.yaml;..\..\PocketTTSStudioLite\RuntimeMetadata\**\*.json" Link="RuntimeMetadata\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
